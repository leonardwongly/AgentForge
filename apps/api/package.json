{
  "name": "@agentforge/api",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx dist/apps/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run apps/api/test"
  },
  "dependencies": {
    "@agentforge/config": "workspace:*",
    "@agentforge/core": "workspace:*",
    "@agentforge/db": "workspace:*",
    "@agentforge/detectors": "workspace:*",
    "@agentforge/github": "workspace:*",
    "@agentforge/policy": "workspace:*",
    "@agentforge/records": "workspace:*",
    "@agentforge/notifications": "workspace:*",
    "@agentforge/reviewers": "workspace:*",
    "@agentforge/security": "workspace:*",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "11.1.0",
    "bullmq": "5.79.2",
    "fastify": "5.12.1",
    "ioredis": "5.11.1",
    "zod": "4.4.3"
  }
}
