{
  "name": "@agentforge/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@agentforge/config": "workspace:*",
    "@agentforge/core": "workspace:*",
    "@agentforge/db": "workspace:*",
    "@agentforge/detectors": "workspace:*",
    "@agentforge/github": "workspace:*",
    "@agentforge/policy": "workspace:*",
    "@agentforge/records": "workspace:*",
    "@agentforge/security": "workspace:*",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "bullmq": "5.76.8",
    "fastify": "5.8.5",
    "ioredis": "5.10.1",
    "zod": "4.4.3"
  }
}
