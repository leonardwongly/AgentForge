{
  "name": "@agentforge/worker",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx dist/apps/worker/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentforge/config": "workspace:*",
    "@agentforge/core": "workspace:*",
    "@agentforge/db": "workspace:*",
    "@agentforge/detectors": "workspace:*",
    "@agentforge/github": "workspace:*",
    "@agentforge/policy": "workspace:*",
    "@agentforge/records": "workspace:*",
    "@agentforge/security": "workspace:*",
    "bullmq": "5.80.9",
    "ioredis": "5.11.1"
  }
}
