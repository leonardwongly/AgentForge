# PostgreSQL connection string used by Prisma and API services.
DATABASE_URL=postgresql://agentforge:agentforge@localhost:15432/agentforge

# Redis connection string used by BullMQ workers and queues.
REDIS_URL=redis://localhost:6379

# Runtime environment. Use production for deployed services.
NODE_ENV=development

# Numeric GitHub App identifier from GitHub App settings.
GITHUB_APP_ID=

# PEM private key for the GitHub App. Use escaped newlines in hosted env vars.
GITHUB_APP_PRIVATE_KEY=

# Shared webhook secret configured in GitHub App settings.
GITHUB_WEBHOOK_SECRET=

# Local-only escape hatch for fixture webhook testing without a secret.
# Keep false for normal development and all deployed environments.
ALLOW_UNSIGNED_GITHUB_WEBHOOKS=false

# OAuth client ID for the GitHub App, used by dashboard installation flows.
GITHUB_CLIENT_ID=

# OAuth client secret for the GitHub App. Never expose to browser code.
GITHUB_CLIENT_SECRET=

# Public dashboard base URL.
APP_BASE_URL=http://localhost:3000

# Public API base URL.
API_BASE_URL=http://localhost:4000

# Default policy mode when org/repository/rule config does not override it.
# Allowed values: observe, warn, enforce, optimize.
DEFAULT_POLICY_MODE=observe

# Store source code blobs. Default false; V1 stores metadata and findings only.
SOURCE_CODE_STORAGE=false

# Full diff retention policy: disabled, 7d, 30d, or custom.
FULL_DIFF_RETENTION=disabled

# Redact secrets in logs, snippets, check summaries, exports, and prompts.
REDACT_SECRETS=true

# Optional advisory AI features. Blocking decisions never depend on this.
LLM_FEATURES=false

# Retention period for audit and change-control records.
AUDIT_RECORD_RETENTION_DAYS=365

# Optional object storage bucket for exports.
EXPORT_STORAGE_BUCKET=

# Optional object storage region for exports.
EXPORT_STORAGE_REGION=

# Dashboard/API session signing secret. Required before production deployment.
SESSION_SECRET=

# Server-side actor used by local dashboard server actions when saving settings.
# Production deployments should resolve this from authenticated user context.
AGENTFORGE_DASHBOARD_ACTOR=dashboard-local

# Server-side role used by local dashboard server actions for repository setup.
# Must be platform_admin or engineering_manager to change policies/settings.
AGENTFORGE_DASHBOARD_ROLE=platform_admin

# Trust authenticated actor/role headers at the API boundary. Set true only
# behind an ingress that strips spoofed client identity headers before injecting
# x-agentforge-authenticated-actor and x-agentforge-authenticated-role.
AGENTFORGE_API_TRUST_PROXY_HEADERS=false

# Explicitly allow x-agentforge-actor / x-agentforge-role at the API boundary in
# production-like local runs. Keep false for deployed environments.
AGENTFORGE_API_ALLOW_LOCAL_ACTOR_HEADERS=false

# Trust authenticated actor/role headers injected by a production auth proxy.
# When true, dashboard server actions read x-agentforge-authenticated-actor
# and x-agentforge-authenticated-role before calling the API.
AGENTFORGE_DASHBOARD_TRUST_PROXY_HEADERS=false

# Explicitly allow AGENTFORGE_DASHBOARD_ACTOR/ROLE in production-like local runs.
# Keep false for deployed environments with real authentication.
AGENTFORGE_DASHBOARD_ALLOW_LOCAL_ACTOR=false
