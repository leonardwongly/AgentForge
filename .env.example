# PostgreSQL connection string used by Prisma and API services.
DATABASE_URL=postgresql://agentforge:agentforge@localhost:15432/agentforge

# Redis connection string used by BullMQ workers and queues.
REDIS_URL=redis://:agentforge-local-redis@127.0.0.1:6379

# Runtime environment. Leave unset locally (it defaults to "development"); set
# NODE_ENV=production only in deployed services. Do not hardcode "development"
# here, because it is inherited by `next build` and breaks production prerendering.

# Numeric GitHub App identifier from GitHub App settings.
GITHUB_APP_ID=

# PEM private key for the GitHub App. Use escaped newlines in hosted env vars.
GITHUB_APP_PRIVATE_KEY=

# Optional local smoke-test target. Runtime webhook jobs use the installation id from webhook payloads.
GITHUB_INSTALLATION_ID=

# Shared webhook secret configured in GitHub App settings.
GITHUB_WEBHOOK_SECRET=

# GitHub App slug used to build the in-dashboard installation URL.
GITHUB_APP_SLUG=

# Local-only escape hatch for fixture webhook testing without a secret.
# Keep false for normal development and all deployed environments.
ALLOW_UNSIGNED_GITHUB_WEBHOOKS=false

# OAuth client ID for the GitHub App, used by dashboard installation flows.
GITHUB_CLIENT_ID=

# OAuth client secret for the GitHub App. Never expose to browser code.
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins that become platform_admin via built-in GitHub OAuth.
AGENTFORGE_GITHUB_ADMIN_LOGINS=

# Comma-separated GitHub logins that become developer via built-in GitHub OAuth.
AGENTFORGE_GITHUB_ALLOWED_LOGINS=

# Public dashboard base URL.
APP_BASE_URL=http://localhost:3000

# Public API base URL.
API_BASE_URL=http://localhost:4000

# Default policy mode when org/repository/rule config does not override it.
# Allowed values: observe, warn, enforce, optimize.
DEFAULT_POLICY_MODE=observe

# Store source code blobs. Default false; V1 stores metadata and findings only.
SOURCE_CODE_STORAGE=false

# Full diff retention policy: disabled, 7d, 30d, or custom.
FULL_DIFF_RETENTION=disabled

# Redact secrets in logs, snippets, check summaries, exports, and prompts.
REDACT_SECRETS=true

# Optional advisory AI features. Blocking decisions never depend on this.
LLM_FEATURES=false

# Retention period for audit and change-control records.
AUDIT_RECORD_RETENTION_DAYS=365

# Reserved for a future object-storage export adapter. V1 exports use API job downloads.
EXPORT_STORAGE_BUCKET=

# Reserved for a future object-storage export adapter. V1 exports use API job downloads.
EXPORT_STORAGE_REGION=

# Dashboard/API session signing secret. Required before production deployment.
SESSION_SECRET=

# Server-side actor used only when AGENTFORGE_DASHBOARD_ALLOW_LOCAL_ACTOR=true.
# Production deployments should resolve this from authenticated user context.
AGENTFORGE_DASHBOARD_ACTOR=dashboard-local

# Server-side role used by explicit local dashboard fallback. The onboarding
# sample persists a policy preview, so the local smoke-test example uses an
# admin role. Do not enable local actor fallback in shared or production
# environments.
AGENTFORGE_DASHBOARD_ROLE=platform_admin

# Server-side organization used by local dashboard server actions.
AGENTFORGE_DASHBOARD_ORGANIZATION=org_local

# Trust authenticated actor/role/organization headers at the API boundary. Set true only
# behind an ingress that strips spoofed client identity headers before injecting
# x-agentforge-authenticated-actor, x-agentforge-authenticated-role, and
# x-agentforge-authenticated-organization.
AGENTFORGE_API_TRUST_PROXY_HEADERS=false

# Explicitly allow x-agentforge-actor / x-agentforge-role / x-agentforge-organization
# at the API boundary in local smoke runs. Keep false for deployed environments.
AGENTFORGE_API_ALLOW_LOCAL_ACTOR_HEADERS=false

# Trust authenticated actor/role/organization headers injected by a production auth proxy.
# When true, dashboard server actions read x-agentforge-authenticated-actor
# x-agentforge-authenticated-role, and x-agentforge-authenticated-organization before calling the API.
AGENTFORGE_DASHBOARD_TRUST_PROXY_HEADERS=false

# Shared HMAC secret the ingress/auth proxy uses to SIGN the
# x-agentforge-authenticated-* identity headers it injects into the dashboard.
# Required in production when AGENTFORGE_DASHBOARD_TRUST_PROXY_HEADERS=true so the
# dashboard cryptographically verifies inbound identity instead of trusting the
# network. The proxy signs HMAC-SHA256 over
# "<unix-seconds>:<nonce>:<actor>:<role>:<organization>" and sends
# x-agentforge-signature-timestamp, x-agentforge-signature-nonce, and
# x-agentforge-signature.
AGENTFORGE_DASHBOARD_PROXY_SECRET=

# Explicitly allow AGENTFORGE_DASHBOARD_ACTOR/ROLE/ORGANIZATION in local smoke runs.
# This is allowed only on localhost/127.0.0.1/[::1] APP_BASE_URL and API_BASE_URL.
# Keep false for deployed environments with real authentication.
AGENTFORGE_DASHBOARD_ALLOW_LOCAL_ACTOR=false

# Expose the sample-preview onboarding action. Auto-enabled outside production;
# in a deployed instance set to true to enable it (AGENTFORGE_SAMPLE_FIXTURE_ROOT
# is optional — the action locates the bundled fixtures/ directory automatically).
AGENTFORGE_ENABLE_SAMPLE_PREVIEW=false

# Production startup requires this acknowledgement after ingress header stripping is verified.
AGENTFORGE_AUTH_PROXY_STRIPS_HEADERS=false

# Optional outbound webhook for governance notifications (e.g. blocked PRs).
# Leave empty to disable. Slack/Teams can subscribe to this endpoint.
NOTIFICATION_WEBHOOK_URL=

# Optional SIEM-style webhook for streaming tamper-evident audit events.
# Leave empty to disable. Used by POST /api/admin/audit-stream.
AUDIT_STREAM_WEBHOOK_URL=
