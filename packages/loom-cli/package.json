{
  "name": "@agentforge/loom-cli",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "bin": {
    "loom": "dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/loom-cli/src/*.test.ts"
  },
  "dependencies": {
    "@agentforge/core": "workspace:*",
    "@agentforge/loom-core": "workspace:*",
    "@agentforge/loom-git-bridge": "workspace:*",
    "@agentforge/loom-provenance": "workspace:*",
    "@agentforge/loom-ratify": "workspace:*",
    "@agentforge/policy": "workspace:*"
  }
}
